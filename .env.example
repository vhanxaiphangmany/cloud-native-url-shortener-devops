# Copy to .env for local development. Replace every password before use.
# Never commit .env or use these sample credentials in a public environment.

# PostgreSQL
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change-this-local-password

# URL Shortener API
PUBLIC_BASE_URL=http://localhost:8080
CACHE_TTL_SECONDS=3600

# Published host ports
HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana local admin account
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# Optional Terraform local provider settings (set in terraform/terraform.tfvars).
# Do not commit terraform.tfvars or real credentials.
