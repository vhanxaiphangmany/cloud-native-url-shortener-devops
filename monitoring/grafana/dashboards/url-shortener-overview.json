      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum(rate(url_shortener_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(url_shortener_http_requests_total[5m])), 1e-9)", "legendFormat": "5xx error ratio", "refId": "A" }, { "expr": "sum(rate(url_shortener_http_requests_total{status=~\"4..\"}[5m])) / clamp_min(sum(rate(url_shortener_http_requests_total[5m])), 1e-9)", "legendFormat": "4xx response ratio", "refId": "B" }],
      "title": "HTTP Error Rates",
      "type": "timeseries"
