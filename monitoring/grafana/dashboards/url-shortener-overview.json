      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, path) (rate(url_shortener_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{path}}", "refId": "A" }, { "expr": "histogram_quantile(0.50, sum by (le, path) (rate(url_shortener_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{path}}", "refId": "B" }],
      "title": "HTTP Latency (p50 / p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
